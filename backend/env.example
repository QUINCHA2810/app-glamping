# Copia este archivo como ".env" (sin el ".example") y complétalo.
# NUNCA subas el .env real a GitHub — agrégalo a .gitignore.

# Datos del proyecto Supabase (Project Settings → API). El backend no los usa: se conecta por DATABASE_URL
SUPABASE_URL=https://[REF-DEL-PROYECTO].supabase.co
SUPABASE_ANON_KEY=[CLAVE-PUBLICABLE-DEL-PROYECTO]

# Conexión directa a Postgres para SQLAlchemy/Alembic.
# Reemplaza [TU-PASSWORD-AQUI] por la contraseña de la base de datos
# (Supabase Dashboard → Project Settings → Database → Database password)
DATABASE_URL=postgresql://postgres:[TU-PASSWORD-AQUI]@db.[REF-DEL-PROYECTO].supabase.co:5432/postgres

# Base del modelo v2 (rama feature/modelo-simplificado, docs/modelo_v2/MAPEO.md): es la
# que usan el backend, el listener y las herramientas en esa rama, y la de
# `alembic -c alembic_v2.ini`. Otro proyecto de Supabase: NUNCA la misma base que DATABASE_URL.
# DATABASE_URL (arriba) se sigue usando para respaldar la v1: tools/respaldo_bd.py --origen v1.
DATABASE_URL_V2=postgresql://postgres:[TU-PASSWORD-V2]@db.[REF-DEL-PROYECTO-V2].supabase.co:5432/postgres

# Si más adelante escalan a muchas conexiones simultáneas (varios domos en producción),
# usen el connection pooler de Supabase en vez de la línea de arriba:
# DATABASE_URL=postgresql://postgres.[REF-DEL-PROYECTO]:[TU-PASSWORD-AQUI]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Autenticación (R-1) — firma de los JWT emitidos por /auth/login.
# Genera un valor propio y aleatorio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA reutilices el mismo valor entre entornos (dev/prod) ni lo subas a GitHub.
JWT_SECRET_KEY=[GENERA-UN-VALOR-ALEATORIO-AQUI]
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Broker MQTT (Mosquitto, ver docker-compose.yml en la raíz del proyecto)
# — usado por mqtt_listener.py. Los valores por defecto sirven para
# desarrollo local (Mosquitto corriendo con `docker compose up`).
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# CORS — orígenes del frontend web autorizados a llamar al API, separados
# por comas. Por defecto, el servidor de desarrollo de Vite (frontend/).
CORS_ORIGINS=http://localhost:5173

# Interfaz en la que escucha `python main.py` (por defecto 127.0.0.1, solo este equipo).
# No hace falta abrirla: el frontend llega por el proxy de Vite y el ESP32 usa MQTT.
# Lo recomendado es arrancar con `uvicorn main:app`, que también escucha en 127.0.0.1.
# API_HOST=127.0.0.1

# Documentación del API (/docs, /redoc, /openapi.json). "false" = modo público
# (Tailscale Funnel, docs/publicacion_web.md): la cierra y exige JWT_SECRET_KEY de al
# menos 32 caracteres para arrancar.
API_DOCS=true

# R-13 automático — mqtt_listener.py evalúa el algoritmo de supervivencia
# después de cada lectura de batería que inserta. "false" lo desactiva.
R13_AUTO=true
# Como máximo una evaluación automática por domo cada este número de segundos.
R13_AUTO_INTERVALO_S=30

# Clima de referencia — mqtt_listener.py consulta Open-Meteo (sin clave) para cada domo
# con latitud y longitud, al arrancar y luego cada CLIMA_INTERVALO_S. "false" lo desactiva.
CLIMA_AUTO=true
CLIMA_INTERVALO_S=900
