#pragma once
// Copia este archivo como secrets.h y pon tus valores reales. secrets.h NO se sube a GitHub
// (está en .gitignore). Nunca lo pegues en un chat ni en un issue.

#define WIFI_SSID      "tu_ssid"
#define WIFI_PASSWORD  "tu_password"
#define MQTT_BROKER_IP "192.168.0.150"         // IPv4 del PC con Mosquitto (ipconfig)

// Cargas Tuya, una por línea (una línea = un id_fisico de la app):
//   { id_fisico, tipo, ID de Tuya, IP, local key, versión, DPS }
//
//   id_fisico : el MISMO texto que el campo id_fisico del dispositivo en la app
//               (Dispositivos > editar). Si no coincide, la orden no llega. Solo letras,
//               números, _ y -, hasta 32 caracteres (va en el tema MQTT).
//   tipo      : TIPO_TOMA o TIPO_BOMBILLO
//   ID        : "device id" de Tuya. Obligatorio: va en las órdenes 3.3, reconoce el anuncio
//               UDP y agrupa las salidas de un mismo equipo. En el monitor solo se ven sus
//               4 últimos caracteres.
//   IP        : { 0, 0, 0, 0 } = la que el dispositivo anuncia en la red (Descubrimiento.ino):
//               si el router le cambia la IP, se actualiza sola. Si la escribes, manda la
//               escrita (y el comando "estado" avisa si la anunciada es otra).
//   local key : 16 caracteres, tal cual la entrega `python -m tinytuya wizard`
//               (cambia si vuelves a emparejar el dispositivo en la app Tuya/Smart Life)
//   versión   : 33, 34 o 35 (protocolo 3.3, 3.4 o 3.5); 0 = la que anuncia el dispositivo
//   DPS       : el DPS de encendido de ESTA carga. 0 o sin poner = 1 en tomas, 20 en bombillos.
//               En un bombillo, el modo y el brillo son DPS+1 y DPS+2 (21 y 22).
//
// Varias líneas con el MISMO ID de Tuya son salidas del mismo equipo: deben tener la misma
// IP, local key y versión, y distinto DPS. Abajo, la toma de pared de 3 salidas son 3 cargas
// (toma1, toma1_s2, toma1_usb), cada una con su categoría en la app para que R-13 corte
// primero la menos importante. Las órdenes al mismo equipo se ejecutan de a una.
//
// tinytuya wizard, scan y snapshot IMPRIMEN las local keys: córrelos solo en $HOME\tuya_local
// y nunca pegues su salida en ningún lado. Ver firmware/README.md.
// Una entrada con datos inválidos queda desactivada y se avisa al arrancar (comando "estado").
// IPs del prototipo (reservadas en el router): bombillo1 .160, toma2 .161, toma de pared .162.
#define DISPOSITIVOS_TUYA {                                                                                  \
    { "toma1",     TIPO_TOMA,     "ID_TUYA_TOMA1",     { 192, 168, 0, 162 }, "LOCAL_KEY_TOMA_1", 33, 1  },  \
    { "toma1_s2",  TIPO_TOMA,     "ID_TUYA_TOMA1",     { 192, 168, 0, 162 }, "LOCAL_KEY_TOMA_1", 33, 2  },  \
    { "toma1_usb", TIPO_TOMA,     "ID_TUYA_TOMA1",     { 192, 168, 0, 162 }, "LOCAL_KEY_TOMA_1", 33, 3  },  \
    { "toma2",     TIPO_TOMA,     "ID_TUYA_TOMA2",     { 192, 168, 0, 161 }, "LOCAL_KEY_TOMA_2", 34, 1  },  \
    { "bombillo1", TIPO_BOMBILLO, "ID_TUYA_BOMBILLO1", { 192, 168, 0, 160 }, "LOCAL_KEY_BOMB_1", 35, 20 },  \
}
